NODE_ENV=development
DATABASE_DRIVER=__DATABASE_DRIVER__
DATABASE_URL=
# Optional connection pool tuning (all optional; SQL drivers only, mongodb uses the equivalent client options).
DATABASE_POOL_MAX=
DATABASE_POOL_IDLE_TIMEOUT_MS=
DATABASE_POOL_CONNECTION_TIMEOUT_MS=

# Tenant IDs select a security boundary. Membership still requires server authorization.
DEFAULT_TENANT_ID=default
VITE_DEFAULT_TENANT_ID=default

# local (Argon2id), asgardeo, keycloak, oidc, or none
AUTH_PROVIDER=__AUTH_PROVIDER__
# Optional local-auth pepper. Supply through a deployment secret manager in production.
AUTH_PASSWORD_PEPPER=

# Shared OIDC settings. Never expose AUTH_CLIENT_SECRET to browser code.
AUTH_ISSUER_URL=
AUTH_CLIENT_ID=
AUTH_CLIENT_SECRET=
AUTH_REDIRECT_URI=http://localhost:3000/auth/callback
AUTH_SCOPES=openid profile email

# Provider shortcuts used when AUTH_ISSUER_URL is blank.
ASGARDEO_ORGANIZATION=
ASGARDEO_CLIENT_ID=
ASGARDEO_CLIENT_SECRET=
KEYCLOAK_BASE_URL=http://localhost:8080
KEYCLOAK_REALM=
KEYCLOAK_CLIENT_ID=
KEYCLOAK_CLIENT_SECRET=

# This is the only authentication value exposed to the TSX client.
VITE_AUTH_PROVIDER=__AUTH_PROVIDER__

# Tenant-bound AES-256-GCM. Use a vault/KMS in production; `zolt env:init` can create a local key.
CRYPTO_MASTER_KEY=
CRYPTO_KEY_ID=development

# Object storage: none, local, s3, gcs, azure
STORAGE_PROVIDER=__STORAGE_PROVIDER__
STORAGE_LOCAL_PATH=./storage
STORAGE_BUCKET=
STORAGE_REGION=
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=

# Email: none, smtp, ses, sendgrid, mailgun
MAIL_PROVIDER=__MAIL_PROVIDER__
MAIL_FROM=
MAIL_REGION=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_API_KEY=
