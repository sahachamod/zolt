{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": ".",
    "outDir": "dist-server",
    "allowImportingTsExtensions": false,
    "noEmit": false,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": true
  },
  "include": ["server/**/*.ts", "zolt.config.ts", "routes/**/*.ts", "models/**/*.ts"]
}
